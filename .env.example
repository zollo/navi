# ─────────────────────────────────────────────────────────────
# Navi environment configuration
# Copy to `.env` and fill in real values for local development.
# ─────────────────────────────────────────────────────────────

# --- Core ---
NAVI_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated origins allowed by CORS (the frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# The URL people use to reach Navi; pages live at NAVI_PUBLIC_URL/<handle>
NAVI_PUBLIC_URL=http://localhost:8080

# --- Database ---
POSTGRES_USER=navi
POSTGRES_PASSWORD=navi
POSTGRES_DB=navi
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full URL is derived from the parts above by config.py, override if needed:
# DATABASE_URL=postgresql+asyncpg://navi:navi@postgres:5432/navi

# --- Auth ---
# Session token lifetime for the web UI
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256
# Let anyone create an account (and a page) from the sign-up page
ALLOW_REGISTRATION=true

# --- Avatars ---
MAX_AVATAR_KB=1024

# --- Frontend (baked at build time) ---
# Leave EMPTY for same-origin: the frontend nginx proxies /api to the backend,
# so the SPA uses relative URLs and works behind any host. Only set this to an
# absolute URL when the API is served from a different origin.
VITE_API_BASE_URL=
