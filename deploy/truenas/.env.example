# ─────────────────────────────────────────────────────────────────────────
# Navi — TrueNAS environment. Copy to `.env` next to docker-compose.yml.
# Generate strong secrets:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────

# Where persistent Postgres data lives. MUST be a real dataset path on your
# pool — change 'tank' to your pool name. Create it first (see README).
NAVI_DATA=/mnt/tank/apps/navi

# Host port to expose the web UI (and /api) on.
NAVI_PORT=30083

# The URL people will use to reach Navi (pages live at NAVI_PUBLIC_URL/<handle>).
NAVI_PUBLIC_URL=http://truenas.local:30083

# Image tag to run (latest, X.Y.Z, X.Y, or sha-<short>).
NAVI_TAG=latest

# --- Secrets ---
# SECRET_KEY is required (the stack refuses to start without it).
SECRET_KEY=
# Set before the first start; defaults to "navi" (Postgres is internal-only).
POSTGRES_PASSWORD=

# --- Optional overrides ---
POSTGRES_USER=navi
POSTGRES_DB=navi
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Let anyone sign up and create a page.
ALLOW_REGISTRATION=true
MAX_AVATAR_KB=1024
