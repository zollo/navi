{
  "openapi": "3.1.0",
  "info": {
    "title": "Navi",
    "description": "Navi gives everyone one simple page for their important links, public at\n`/<handle>`.\n\n* Read any page anonymously with `GET /api/pages/{handle}`.\n* Sign up or sign in with `POST /api/auth/register` / `POST /api/auth/login`, then send\n  `Authorization: Bearer <token>` to create and edit your own page at `/api/pages/me`.\n",
    "version": "dev"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Liveness \u2014 always cheap, no dependencies.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness",
        "description": "Readiness \u2014 checks the database; 503 when it is unreachable.",
        "operationId": "readiness",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/api/build-info": {
      "get": {
        "tags": [
          "health",
          "meta"
        ],
        "summary": "Build Info",
        "description": "Current build plus the URLs integrations need. Requires authentication.",
        "operationId": "build_info",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildInfo"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/config": {
      "get": {
        "tags": [
          "health",
          "meta"
        ],
        "summary": "Public Config",
        "description": "Upload limits for clients, such as the largest avatar the API accepts. Public.",
        "operationId": "public_config",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Exchange email + password for a bearer token.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register",
        "description": "Self-service sign-up (if enabled).",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Me",
        "description": "The authenticated user.",
        "operationId": "whoami",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "patch": {
        "tags": [
          "auth"
        ],
        "summary": "Update Me",
        "description": "Change your display name or password.",
        "operationId": "update_me",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/auth/config": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Auth Config",
        "description": "Tells the sign-in page which options to render.",
        "operationId": "auth_config",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/pages/me": {
      "get": {
        "tags": [
          "pages"
        ],
        "summary": "Get My Page",
        "description": "Your page, or 404 if you haven't created it yet.",
        "operationId": "get_my_page",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageRead"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "put": {
        "tags": [
          "pages"
        ],
        "summary": "Save My Page",
        "description": "Create your page, or replace its handle, header, social icons and sections.\n\nSend the whole page: sections and links not in the request are removed, and list\norder is display order.",
        "operationId": "save_my_page",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PageIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageRead"
                }
              }
            }
          },
          "201": {
            "description": "Page created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "delete": {
        "tags": [
          "pages"
        ],
        "summary": "Delete My Page",
        "description": "Delete your page. Your account stays, and you can create a new page later.",
        "operationId": "delete_my_page",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/pages/me/avatar": {
      "put": {
        "tags": [
          "pages"
        ],
        "summary": "Upload My Avatar",
        "description": "Upload a PNG, JPEG, WebP or GIF avatar (multipart `file`).",
        "operationId": "upload_my_avatar",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_my_avatar"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "delete": {
        "tags": [
          "pages"
        ],
        "summary": "Delete My Avatar",
        "description": "Remove your avatar.",
        "operationId": "delete_my_avatar",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageRead"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/pages/icons": {
      "get": {
        "tags": [
          "pages"
        ],
        "summary": "List Icons",
        "description": "Icon names accepted for social icons and links.",
        "operationId": "list_icons",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IconList"
                }
              }
            }
          }
        }
      }
    },
    "/api/pages/handles/{handle}": {
      "get": {
        "tags": [
          "pages"
        ],
        "summary": "Check Handle",
        "description": "Whether a handle can be used for a page.",
        "operationId": "check_handle",
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "HTTPBearer": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Handle"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HandleCheck"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/pages/{handle}": {
      "get": {
        "tags": [
          "pages"
        ],
        "summary": "Get Page",
        "description": "A public page by handle (no authentication).",
        "operationId": "get_page",
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Handle"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/pages/{handle}/avatar": {
      "get": {
        "tags": [
          "pages"
        ],
        "summary": "Get Avatar",
        "description": "A page's avatar image. URLs carry `?v=` so they can be cached for a long time.",
        "operationId": "get_avatar",
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Handle"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "image/*": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthConfig": {
        "properties": {
          "registration_enabled": {
            "type": "boolean",
            "title": "Registration Enabled"
          }
        },
        "type": "object",
        "required": [
          "registration_enabled"
        ],
        "title": "AuthConfig"
      },
      "Body_upload_my_avatar": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_my_avatar"
      },
      "BuildInfo": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "git_commit": {
            "type": "string",
            "title": "Git Commit"
          },
          "build_time": {
            "type": "string",
            "title": "Build Time"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "public_url": {
            "type": "string",
            "title": "Public Url"
          },
          "api_docs_url": {
            "type": "string",
            "title": "Api Docs Url"
          },
          "openapi_url": {
            "type": "string",
            "title": "Openapi Url"
          }
        },
        "type": "object",
        "required": [
          "version",
          "git_commit",
          "build_time",
          "environment",
          "public_url",
          "api_docs_url",
          "openapi_url"
        ],
        "title": "BuildInfo"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HandleCheck": {
        "properties": {
          "handle": {
            "type": "string",
            "title": "Handle"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "handle",
          "available"
        ],
        "title": "HandleCheck"
      },
      "Icon": {
        "type": "string",
        "enum": [
          "link",
          "website",
          "email",
          "video",
          "music",
          "podcast",
          "blog",
          "shop",
          "calendar",
          "instagram",
          "threads",
          "x",
          "twitter",
          "tiktok",
          "linkedin",
          "github",
          "youtube",
          "facebook",
          "twitch",
          "discord",
          "signal",
          "whatsapp",
          "telegram",
          "mastodon",
          "bluesky",
          "reddit",
          "spotify"
        ],
        "title": "Icon",
        "description": "Icons for social buttons and link cards. Stored as VARCHAR: adding one needs\nno migration, only the enum value and an entry in the frontend's `lib/icons.tsx`."
      },
      "IconList": {
        "properties": {
          "icons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Icons"
          }
        },
        "type": "object",
        "required": [
          "icons"
        ],
        "title": "IconList"
      },
      "LinkIn": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title"
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url"
          },
          "icon": {
            "$ref": "#/components/schemas/Icon",
            "default": "link"
          }
        },
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "title": "LinkIn"
      },
      "LinkRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "icon": {
            "$ref": "#/components/schemas/Icon"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "icon"
        ],
        "title": "LinkRead"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "PageIn": {
        "properties": {
          "handle": {
            "type": "string",
            "maxLength": 30,
            "minLength": 3,
            "title": "Handle"
          },
          "title": {
            "type": "string",
            "maxLength": 80,
            "title": "Title",
            "default": ""
          },
          "tagline": {
            "type": "string",
            "maxLength": 300,
            "title": "Tagline",
            "default": ""
          },
          "socials": {
            "items": {
              "$ref": "#/components/schemas/SocialLinkIn"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Socials"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/SectionIn"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Sections"
          }
        },
        "type": "object",
        "required": [
          "handle"
        ],
        "title": "PageIn"
      },
      "PageRead": {
        "properties": {
          "handle": {
            "type": "string",
            "title": "Handle"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "tagline": {
            "type": "string",
            "title": "Tagline"
          },
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          },
          "socials": {
            "items": {
              "$ref": "#/components/schemas/SocialLinkRead"
            },
            "type": "array",
            "title": "Socials"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/SectionRead"
            },
            "type": "array",
            "title": "Sections"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "handle",
          "title",
          "tagline",
          "avatar_url",
          "socials",
          "sections",
          "updated_at"
        ],
        "title": "PageRead",
        "description": "A page as anyone sees it at /<handle>."
      },
      "PublicConfig": {
        "properties": {
          "max_avatar_kb": {
            "type": "integer",
            "title": "Max Avatar Kb"
          },
          "avatar_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Avatar Types"
          }
        },
        "type": "object",
        "required": [
          "max_avatar_kb",
          "avatar_types"
        ],
        "title": "PublicConfig",
        "description": "Limits the SPA needs before it talks to the API (no auth)."
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "display_name": {
            "type": "string",
            "maxLength": 255,
            "title": "Display Name",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "SectionIn": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 80,
            "title": "Title",
            "default": ""
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/LinkIn"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Links"
          }
        },
        "type": "object",
        "title": "SectionIn"
      },
      "SectionRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/LinkRead"
            },
            "type": "array",
            "title": "Links"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "links"
        ],
        "title": "SectionRead"
      },
      "SocialLinkIn": {
        "properties": {
          "icon": {
            "$ref": "#/components/schemas/Icon"
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "icon",
          "url"
        ],
        "title": "SocialLinkIn"
      },
      "SocialLinkRead": {
        "properties": {
          "icon": {
            "$ref": "#/components/schemas/Icon"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "icon",
          "url"
        ],
        "title": "SocialLinkRead"
      },
      "Token": {
