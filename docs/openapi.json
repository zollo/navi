  "components": {
    "schemas": {
      "AuthConfig": {
        "properties": {
          "registration_enabled": {
            "type": "boolean",
            "title": "Registration Enabled"
          }
        },
        "type": "object",
        "required": [
          "registration_enabled"
        ],
        "title": "AuthConfig"
      },
      "AvatarShape": {
        "type": "string",
        "enum": [
          "circle",
          "rounded",
          "square"
        ],
        "title": "AvatarShape"
      },
      "BackgroundKind": {
        "type": "string",
        "enum": [
          "default",
          "solid",
          "gradient",
          "image",
          "curated"
        ],
        "title": "BackgroundKind"
      },
      "BackgroundList": {
        "properties": {
          "backgrounds": {
            "items": {
              "$ref": "#/components/schemas/BackgroundRead"
            },
            "type": "array",
            "title": "Backgrounds"
          }
        },
        "type": "object",
        "required": [
          "backgrounds"
        ],
        "title": "BackgroundList"
      },
      "BackgroundRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "image_url": {
            "type": "string",
            "title": "Image Url"
          },
          "dark": {
            "type": "boolean",
            "title": "Dark"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "image_url",
          "dark"
        ],
        "title": "BackgroundRead"
      },
      "BackgroundUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "dark": {
